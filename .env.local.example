# Cafe Mehfile - ordering system configuration
# Copy this to .env.local and fill in real values.

# Google Apps Script Web App URL (ends in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=

# SECRET_TOKEN from the Apps Script file (server-side only)
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# Cafe WhatsApp number (E.164 digits, no + or spaces)
CAFE_WHATSAPP_NUMBER=919373861759

# UPI payment details (leave empty to hide UPI section)
CAFE_UPI_ID=
CAFE_UPI_PAYEE=Cafe Mehfile
CAFE_UPI_QR_IMAGE=

# Number of dine-in tables
CAFE_TABLE_COUNT=20
